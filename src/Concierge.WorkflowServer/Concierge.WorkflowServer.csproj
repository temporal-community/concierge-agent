<Project>
  <Sdk Name="Microsoft.NET.Sdk.Web" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pinned here, in exactly one place, so bumping the analyzer package is a one-line change,
         independent of this template package's own MinVer-derived version. -->
    <TemporalCommunityAnalyzersVersion>0.5.0</TemporalCommunityAnalyzersVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <PackageReference Include="TemporalCommunity.Extensions.Analyzers" Version="0.6.0" />
    <PackageReference Include="Temporalio" Version="1.21.0" />
    <PackageReference Include="TemporalCommunity.Extensions.AI" Version="0.14.2" />
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.ServiceDefaults\Concierge.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Concierge.Contracts\Concierge.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The evaluation runner reads retrieval arms; core tests exercise the provider's fake-transport contract. -->
    <InternalsVisibleTo Include="Concierge.Evaluation.Runner" />
    <InternalsVisibleTo Include="Concierge.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\schema.sql" />
    <Content Include="..\..\knowledge\hotel-zgy\*.md" Link="knowledge\hotel-zgy\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
